[Unit]
Description=ReleaseDock approved-script executor socket
Before=releasedock-executor.service releasedock-runner.service

[Socket]
ListenStream=/run/releasedock-executor/executor.sock
SocketUser=root
# Only Runner belongs to this dedicated client group. The executor receives the
# already-open listener as fd 3 and needs no permission on its socket path.
SocketGroup=releasedock-executor-client
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=releasedock-executor.service

[Install]
WantedBy=sockets.target
